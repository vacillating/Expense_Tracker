# Telegram bot 需要的环境变量。复制成 .env（已在 .gitignore 里，不会被提交）
# 填真实值，或者在实际部署的平台（Vercel 等）上直接配置环境变量。

# --- Google Sheets（sheets.py，env 读不到时会回落到 st.secrets）---
# 完整的 service account JSON，一整行——不是文件路径，是 JSON 内容本身。
GCP_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'
SHEET_KEY=

# --- LLM（parser.py，OpenAI 兼容协议，先用 DeepSeek）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# --- Telegram（api/telegram.py）---
TELEGRAM_BOT_TOKEN=
# setWebhook 时一起注册的密钥，Telegram 之后每次请求都会带在
# X-Telegram-Bot-Api-Secret-Token 头里——api/telegram.py 用它验证请求真的
# 来自 Telegram，不是别人扫到这个 URL 乱打的。1-256 位，只能是
# A-Z/a-z/0-9/_/- 。生成一个随机值即可，不需要人记得住。
TELEGRAM_WEBHOOK_SECRET=
# Gary 的 Telegram 数字 user id（不是 @username）——单用户白名单，
# 任何 from.id 对不上这个值的消息都会被静默丢弃。可以先发一条消息给
# @userinfobot 拿到自己的 id。
TELEGRAM_ALLOWED_USER_ID=

# --- 时区（config.py，today_local()/now_local() 用）---
# "今天"按哪个时区算——Quick Log 默认日期、Dashboard 的月度统计、
# Telegram bot 传给解析器的 today 都受这个影响。IANA 时区名。
# 不填就用默认值 America/New_York（Gary 目前在亚特兰大）；以后搬回国了
# 改这一个值就行，不用改代码。注意这跟 created_at 审计时间戳无关——
# 那个固定存 UTC，不受这个变量影响。
APP_TIMEZONE=America/New_York
